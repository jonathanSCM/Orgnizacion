# Base de datos (SQLite por defecto para uso local, sin instalar nada más)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini (gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Tope de solicitudes de IA por día (protección de abuso; la capa gratuita de Gemini permite ~1500/día)
GEMINI_DAILY_LIMIT="200"

# Resend (correo transaccional: invitaciones al equipo y recuperación de contraseña)
# Conseguí tu key gratis en https://resend.com/api-keys (capa gratuita: 3000 emails/mes)
RESEND_API_KEY=""
MAIL_FROM="Panel de Organización <onboarding@resend.dev>"
